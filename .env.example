# DEVICE controls everything: which config/*.yaml is loaded and which
# hardware backend (src/io/laptop_io.py vs src/io/pi_gpio.py) is used.
DEVICE=laptop
# DEVICE=raspberrypi

DEFAULT_LOCATION=Bengaluru
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional — override the model paths set in config/<DEVICE>.yaml without
# editing that file. Leave commented out to use the yaml defaults.
# LLM_MODEL=models/llama-3.2-3b-instruct.Q4_K_M.gguf
# LLM_CONTEXT=4096
# STT_MODEL=base.en
# PIPER_VOICE=models/piper/en_US-lessac-medium.onnx
