DEVICE=laptop
DEFAULT_LOCATION=Bengaluru
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Overrides the model paths set in config/<DEVICE>.yaml — set to match
# whatever is actually on disk. These are absolute D:\ paths because C:\ ran
# out of space during setup (see scripts/download_models.sh); config.py
# resolves absolute paths as-is (relative paths stay under models/ instead).
LLM_MODEL=D:/hackathon_models/llama-3.2-3b-instruct.Q4_K_M.gguf
LLM_CONTEXT=4096
STT_MODEL=base.en
PIPER_VOICE=D:/hackathon_models/piper/en_US-lessac-medium.onnx
